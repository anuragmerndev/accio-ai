<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="title" value="Wisper — fully-local dictation pipeline (macOS, Apple Silicon)" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
      <mxGeometry x="240" y="10" width="800" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="user" value="User&#xa;holds Right ⌥ and speaks" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
      <mxGeometry x="40" y="80" width="170" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="hotkey" value="hotkey.py&#xa;pynput global listener&#xa;(push-to-talk)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
      <mxGeometry x="300" y="80" width="180" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="app" value="app.py&#xa;rumps menu-bar orchestrator&#xa;🎤 idle · 🔴 rec · ⏳ processing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
      <mxGeometry x="570" y="80" width="220" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="target" value="Active app&#xa;(focused text field)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
      <mxGeometry x="1080" y="80" width="170" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="audio" value="audio.py&#xa;Recorder (sounddevice)&#xa;16 kHz mono float32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
      <mxGeometry x="40" y="270" width="180" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="worker" value="pipeline.py — single worker thread (queue-fed; all MLX inference on one thread — MLX GPU streams are thread-local)" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="300" y="240" width="740" height="150" as="geometry"/>
    </mxCell>
    <mxCell id="asr" value="asr.py&#xa;Parakeet (en, ~0.9 s) or&#xa;Whisper turbo (100+ langs,&#xa;auto-detect, ~1.8 s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="worker">
      <mxGeometry x="20" y="45" width="170" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="romanize" value="romanize.py&#xa;hi → Hinglish&#xa;(llama3.2, optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="worker">
      <mxGeometry x="220" y="45" width="150" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="rules" value="cleanup.py + dictionary.py&#xa;filler removal,&#xa;personal terms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="worker">
      <mxGeometry x="400" y="45" width="150" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="polish" value="polish.py&#xa;LLM tone + self-corrections&#xa;(en only; mlx or ollama)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="worker">
      <mxGeometry x="580" y="45" width="150" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="paste" value="paste.py&#xa;save clipboard → set text&#xa;→ CGEvent ⌘V → restore" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
      <mxGeometry x="1080" y="270" width="170" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="context" value="context.py&#xa;frontmost app → tone&#xa;(chat / email / code)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
      <mxGeometry x="830" y="80" width="170" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="config" value="~/.wisper/&#xa;config.toml&#xa;dictionary.json" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
      <mxGeometry x="70" y="440" width="120" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="models" value="HF model cache (local disk)&#xa;parakeet-tdt-0.6b-v2&#xa;whisper-large-v3-turbo&#xa;Qwen2.5-1.5B-Instruct-4bit" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
      <mxGeometry x="330" y="440" width="200" height="100" as="geometry"/>
    </mxCell>
    <mxCell id="ollamad" value="Ollama daemon&#xa;localhost:11434&#xa;llama3.2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
      <mxGeometry x="620" y="450" width="160" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="privacy" value="Privacy boundary: everything on-device. Zero network calls at runtime — Hugging Face download on first run only. Audio held in memory, never persisted." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;size=14;" vertex="1" parent="1">
      <mxGeometry x="860" y="580" width="390" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="e1" value="press / release" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="user" target="hotkey">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e2" value="on_start / on_stop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="hotkey" target="app">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e3" value="start / stop mic" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="app" target="audio">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e4" value="audio + tone → queue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="audio" target="asr">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e5" value="(text, lang)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="asr" target="romanize">
      <mxGeometry relative="1" as="geometry"/>
